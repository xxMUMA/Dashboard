# Current platform: Bluesky public search needs no API key

# Future platform: Reddit
REDDIT_CLIENT_ID=replace_with_your_reddit_client_id
REDDIT_CLIENT_SECRET=replace_with_your_reddit_client_secret
REDDIT_USER_AGENT=web:snowlax-dashboard:0.1.0 (by /u/your_username)

# Optional: LinkedIn Community Management integration
LINKEDIN_CLIENT_ID=replace_with_your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=replace_with_your_linkedin_client_secret

# Day 3: server-side persistence (never expose the secret key in browser code)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Day 4: AI sentiment analysis
OPENAI_API_KEY=replace_with_your_openai_api_key
GEMINI_API_KEY=replace_with_your_gemini_api_key
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key

# Day 6: optional Jev sentiment model
JEV_API_KEY=replace_with_your_jev_api_key

# Optional future platform: X uses paid, credit-based API access
X_BEARER_TOKEN=replace_with_your_x_bearer_token
