# No environment variables are needed for the Day 1 sample interface.
# Add later credentials only when enabling the related feature.

# X search
X_BEARER_TOKEN=replace_with_your_x_bearer_token

# Saved searches and mentions
SUPABASE_URL=replace_with_your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key

# Sentiment analysis
OPENAI_API_KEY=replace_with_your_openai_api_key
